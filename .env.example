APP_NAME="Church Command Center"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — SQLite for local dev, PostgreSQL for Railway/production
# The app auto-parses DATABASE_URL (Railway sets this automatically)
DB_CONNECTION=sqlite
# For PostgreSQL (Railway auto-sets these via DATABASE_URL):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=church_command_center
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@churchcommand.com"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_APP_ID=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
